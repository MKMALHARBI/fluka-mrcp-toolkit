# Everything the toolkit generates: the ICRP data it unpacks, the phantom
# cards, the cases and their results, and the FLUKA executable. None of it is
# ours to redistribute and all of it is rebuilt from the zips plus the code.
runs/

# anything built against FLUKA -- CERN licence, not redistributable
mrcp_source.f
flukamrcp
*.o
*.mod

__pycache__/

# machine-specific: where this install keeps the ICRP data and its output
.datapath
.outpath
